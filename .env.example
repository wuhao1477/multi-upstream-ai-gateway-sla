# 复制为 .env 后填写：cp .env.example .env
# .env 含部署密钥，已被 .gitignore 忽略。

# 已发布镜像；升级或回滚时修改为目标版本并执行 docker compose pull。
SLA_IMAGE=ghcr.io/wuhao1477/multi-upstream-ai-gateway-sla:v1.0.0

# 必填。建议使用 URL-safe 的随机值：openssl rand -hex 32
POSTGRES_PASSWORD=
ADMIN_TOKEN=

# 管理 UI/API 仅绑定 127.0.0.1
ADMIN_PORT=8080

# Caddy 站点名；localhost 使用自签证书，内网域名请改成实际主机名。
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
