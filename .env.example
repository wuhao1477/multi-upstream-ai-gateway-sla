# 复制为 .env 后填写：cp .env.example .env
# .env 含部署密钥，已被 .gitignore 忽略。

# 已发布镜像；升级或回滚时修改为目标版本并执行 docker compose pull。
SLA_IMAGE=ghcr.io/wuhao1477/multi-upstream-ai-gateway-sla:v1.0.9

# 必填。外部 PostgreSQL 16+ 连接串；本栈不自带数据库。
# 库需已存在且账号有建表权限（首次启动会跑迁移）。
#
# 库在宿主机上就用 host.docker.internal（compose 里已配好 host-gateway 映射）；
# 库在别的机器上则写实际地址，并把 sslmode 改成 require 及以上。
DATABASE_URL=postgres://sla_gateway:PASSWORD@host.docker.internal:5432/sla_gateway?sslmode=disable

# 必填。建议使用 URL-safe 的随机值：openssl rand -hex 32
ADMIN_TOKEN=

# 可选：Cookie 加密密钥，生成：openssl rand -base64 32
# core 与 collector 使用同一密钥并独立备份；丢失后需重新导入。留空不影响令牌采集。
SLA_COOKIE_SECRET_KEY=

# 上游凭证加密密钥（Key、采集令牌、WebDAV 地址与密码），生成：openssl rand -base64 32
# 与 Cookie 密钥分开生成；core 与 collector 必须相同。随数据库备份一起保管：
# 丢失后已存凭证无法解密，只能重新登记。库里已有明文凭证时，升级前必须先设置。
SLA_CREDENTIAL_SECRET_KEY=

# 可选：允许采集/WebDAV 连接的内网目标。默认只连公网；JSON 键为主机名或 host:port
#（省略端口即任意端口），值为该主机允许解析到的网段。必须用单引号包住整段 JSON。
# 链路本地/云元数据地址无法授权；Cookie 只连公网，不受此项影响。
# 例：SLA_OUTBOUND_PRIVATE_TARGETS='{"nas.lan:5005": ["192.168.1.10/32"]}'
SLA_OUTBOUND_PRIVATE_TARGETS=

# 管理 UI/API 仅绑定 127.0.0.1，不对局域网开放。
ADMIN_PORT=18081
