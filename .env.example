# 复制为 .env 后填写：cp .env.example .env
# .env 含部署密钥，已被 .gitignore 忽略。

# 已发布镜像；升级或回滚时修改为目标版本并执行 docker compose pull。
SLA_IMAGE=ghcr.io/wuhao1477/multi-upstream-ai-gateway-sla:v1.0.7

# 必填。外部 PostgreSQL 16+ 连接串；本栈不自带数据库。
# 库需已存在且账号有建表权限（首次启动会跑迁移）。
#
# 库在宿主机上就用 host.docker.internal（compose 里已配好 host-gateway 映射）；
# 库在别的机器上则写实际地址，并把 sslmode 改成 require 及以上。
DATABASE_URL=postgres://sla_gateway:PASSWORD@host.docker.internal:5432/sla_gateway?sslmode=disable

# 必填。建议使用 URL-safe 的随机值：openssl rand -hex 32
ADMIN_TOKEN=

# 管理 UI/API 仅绑定 127.0.0.1，不对局域网开放。
ADMIN_PORT=18081
