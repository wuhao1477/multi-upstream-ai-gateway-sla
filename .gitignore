.DS_Store
.codegraph/
.codebase-memory/

# 构建产物
/bin/

# 本地环境与凭证（deploy/.env 含上游 key 与 ADMIN_TOKEN，绝不入库）
deploy/.env
*.env
!deploy/.env.example

# 真实渠道导出和本地生成的架构图只用于本地验收，禁止进入公开仓库
all-api-hub-backup-*.json
docs/ARCHIFY-*
docs/superpowers/plans/

# Go
*.test
*.out
coverage.*

# 浏览器验收的依赖与产物
verify/ui/node_modules/
# 注意：pnpm-lock.yaml **要**进版本库。验收脚本用 `pnpm install --frozen-lockfile`，
# 没有 lockfile 时它直接报 ERR_PNPM_NO_LOCKFILE 退出，clone 下来一步都跑不动。

# Python
__pycache__/
*.pyc
